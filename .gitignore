```
# Laravel-specific ignores
/vendor/
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*
/public/css/app.css
/public/js/app.js

# Dependencies
/node_modules/
/composer.lock

# Environment
.env
.env.local
.env.*

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
dist/
build/
target/

# Temporary files
*.tmp
*.swp

# Coverage reports
coverage/
htmlcov/
.coverage

# Package managers
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# PHP specific
.php_cs.cache
.phpunit.result.cache

# Laravel storage
!/storage/*.key
!/storage/*.crt
!/storage/*.pem
```